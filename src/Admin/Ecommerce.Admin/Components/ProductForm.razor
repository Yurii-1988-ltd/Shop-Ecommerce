
<EditForm Model="Model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />

    <MudPaper Elevation="0" Class="product-form-card">

        <div class="product-form-header">
            <MudText Typo="Typo.subtitle1" Class="product-form-title">
                Product information
            </MudText>

            <MudText Typo="Typo.body2" Class="product-form-subtitle">
                Enter the basic information and pricing details
            </MudText>
        </div>

        <div class="product-form-content">

            <MudGrid Spacing="3">

                <MudItem xs="12">
                    <MudTextField T="string"
                                  @bind-Value="Model.Name"
                                  For="@(() => Model.Name)"
                                  Label="Product name"
                                  Placeholder="Enter product name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Product name is required."
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  @bind-Value="Model.Description"
                                  For="@(() => Model.Description)"
                                  Label="Description"
                                  Placeholder="Describe your product"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="4"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  @bind-Value="Model.Sku"
                                  For="@(() => Model.Sku)"
                                  Label="SKU"
                                  Placeholder="e.g. PROD-001"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="SKU is required."
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  @bind-Value="Model.Currency"
                                  For="@(() => Model.Currency)"
                                  Label="Currency"
                                  Placeholder="USD"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="Model.Price"
                                     For="@(() => Model.Price)"
                                     Label="Price"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     RequiredError="Price is required."
                                     Min="0"
                                     Format="0.00"
                                     Immediate="true"
                                     FullWidth="true" />
                </MudItem>

            </MudGrid>

        </div>

        <div class="product-form-footer">

            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Href="/products">
                Cancel
            </MudButton>

            <MudButton ButtonType="ButtonType.Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save"
                       Class="product-form-save-button">
                Save product
            </MudButton>

        </div>

    </MudPaper>
</EditForm>

@code {
    [Parameter]
    public ProductFormModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback<ProductFormModel> OnSubmit { get; set; }

    private async Task Submit()
    {
        await OnSubmit.InvokeAsync(Model);
    }
}
