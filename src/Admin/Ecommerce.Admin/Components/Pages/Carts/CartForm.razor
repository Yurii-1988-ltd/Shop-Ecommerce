@using Ecommerce.Admin.ApiClients.Carts.Models

<EditForm Model="Model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <MudPaper Elevation="0" Class="cart-form-card">
        <div class="cart-form-header">
            <div>
                <MudText Typo="Typo.subtitle1" Class="cart-form-title">
                    Customer information
                </MudText>

                <MudText Typo="Typo.body2" Class="cart-form-subtitle">
                    Enter the customer associated with this shopping cart.
                </MudText>
            </div>

            <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart"
                     Class="cart-form-icon" />
        </div>

        <MudDivider />

        <div class="cart-form-content">
            <MudTextField T="string"
                          Label="Customer ID"
                          @bind-Value="Model.CustomerId"
                          For="@(() => Model.CustomerId)"
                          Variant="Variant.Outlined"
                          Required="true"
                          Immediate="true"
                          Placeholder="Enter customer ID"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Person"
                          Class="cart-form-field" />

            <MudText Typo="Typo.caption" Class="cart-form-hint">
                Specify the ID of the customer who owns this cart.
            </MudText>
        </div>

        <MudDivider />

        <div class="cart-form-footer">
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Save"
                       Class="cart-form-save-button">
                Save cart
            </MudButton>
        </div>
    </MudPaper>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public CartFormModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<CartFormModel> OnSubmit { get; set; }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync(Model);
    }
}
