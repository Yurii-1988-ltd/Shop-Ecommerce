@page "/carts/{CustomerId:guid}/items/{ProductId:guid}/quantity"

@using Ecommerce.Admin.ApiClients.Carts.Contracts
@using Ecommerce.Admin.ApiClients.Carts.Models

@inject ICartApiClient CartApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Change Quantity</PageTitle>

<PageHeader Title="Change Quantity"
            Subtitle="Update product quantity in cart">

    <Actions>
        <MudButton Href="/carts"
                   Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            Back to carts
        </MudButton>
    </Actions>
</PageHeader>

<div class="change-quantity-container">

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Outlined"
                  Class="change-quantity-error">
            @_error
        </MudAlert>
    }

    <MudPaper Elevation="0" Class="change-quantity-card">

        <div class="change-quantity-header">
            <div class="change-quantity-icon">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2"
                         Size="Size.Medium" />
            </div>

            <div>
                <MudText Typo="Typo.subtitle1"
                         Class="change-quantity-title">
                    Product quantity
                </MudText>

                <MudText Typo="Typo.body2"
                         Class="change-quantity-subtitle">
                    Specify the new quantity for this product
                </MudText>
            </div>
        </div>

        <div class="change-quantity-content">
            <ChangeQuantityForm Model="Model"
                                OnSubmit="Save" />
        </div>

    </MudPaper>

</div>

@code {
    [Parameter]
    public Guid CustomerId { get; set; }

    [Parameter]
    public Guid ProductId { get; set; }

    private ChangeQuantityFormModel Model = new();

    private bool _saving;
    private string? _error;

    protected override void OnParametersSet()
    {
        Model.CustomerId = CustomerId;
        Model.ProductId = ProductId;
    }

    private async Task Save(ChangeQuantityFormModel model)
    {
        if (_saving)
            return;

        _saving = true;
        _error = null;

        try
        {
            await CartApi.ChangeQuantityAsync(
                model.CustomerId,
                model.ProductId,
                new ChangeCartItemQuantityRequest(
                    model.CustomerId,
                    model.ProductId,
                    model.Quantity));

            Snackbar.Add(
                "Product quantity updated successfully.",
                Severity.Success);

            Navigation.NavigateTo("/carts");
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
