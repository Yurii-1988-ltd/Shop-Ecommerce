@using Ecommerce.Admin.ApiClients.Carts.Contracts

<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            Change Quantity
        </MudText>
    </TitleContent>

    <DialogContent>

        <MudStack Spacing="3">

            <MudText Typo="Typo.body2">
                Current quantity:
                <b>@CurrentQuantity</b>
            </MudText>

            <MudNumericField T="int"
                             Label="Quantity"
                             @bind-Value="_quantity"
                             Min="1"
                             Required="true"
                             Variant="Variant.Outlined" />

        </MudStack>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@(_quantity <= 0)">
            Update
        </MudButton>

    </DialogActions>

</MudDialog>

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int CurrentQuantity { get; set; }

    private int _quantity;

    protected override void OnInitialized()
    {
        _quantity = CurrentQuantity;
    }

    private void Save()
    {
        MudDialog.Close(DialogResult.Ok(_quantity));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}