@using Ecommerce.Admin.ApiClients.Images
@using Ecommerce.Admin.ApiClients.Images.Contracts
@using Microsoft.AspNetCore.Components.Forms

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-4">
        📸 Upload Image
    </MudText>
    
    <InputFile id="fileInput"
               accept=".jpg,.jpeg,.png,.gif,.webp"
               OnChange="@HandleFileSelected"
               hidden />
    
    <MudButton HtmlTag="label"
               for="fileInput"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.CloudUpload"
               Disabled="@_isUploading"
               Class="mb-3">
        @(_isUploading ? "Uploading..." : "Choose Image")
    </MudButton>

    @if (ProductId == Guid.Empty)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-3">
            ⚠️ Please save the product first before uploading images
        </MudAlert>
    }

    @if (_selectedFile is not null && ProductId != Guid.Empty)
    {
        <MudDivider Class="my-4" />
        
        <MudCard>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        @if (!string.IsNullOrEmpty(_preview))
                        {
                            <div style="border: 2px solid var(--mud-palette-primary); border-radius: 4px; overflow: hidden;">
                                <img src="@_preview" 
                                     alt="Preview" 
                                     style="width: 100%; height: auto; display: block;" />
                            </div>
                        }
                        else
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                        }
                    </MudItem>
                    <MudItem xs="12" sm="8">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            📁 @_selectedFile.Name
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">
                            Size: @FormatBytes(_selectedFile.Size)
                        </MudText>

                        <MudTextField @bind-Value="_altText"
                                      Label="Image Description"
                                      FullWidth="true"
                                      Placeholder="Enter image description"
                                      Class="mb-4"
                                      Variant="Variant.Outlined"
                                      Lines="2" />
                        
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="UploadFileAsync"
                                       Disabled="@_isUploading"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Upload">
                                @(_isUploading ? "Uploading..." : "Upload Image")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       OnClick="CancelUpload"
                                       Disabled="@_isUploading">
                                Cancel
                            </MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }
</MudPaper>

@code
{
    private IBrowserFile? _selectedFile;
    private string _preview = string.Empty;
    private string _altText = string.Empty;
    private bool _isUploading;



    [Parameter]
    public Guid ProductId { get; set; }

    [Parameter]
    public EventCallback OnImagesChanged { get; set; }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
{
    _selectedFile = e.File;
    _altText = _selectedFile?.Name ?? string.Empty;
    _preview = string.Empty;

    if (_selectedFile is null)
        return;

    try
    {
        // Читаем поток во временную MemoryStream, так как напрямую длину stream узнать нельзя
        using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        
        var buffer = ms.ToArray();
        _preview = $"data:{_selectedFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }
    catch (Exception ex)
    {
        Snackbar.Add($"Error reading file: {ex.Message}", Severity.Error);
        _selectedFile = null;
        _preview = string.Empty;
    }
}

    private async Task UploadFileAsync()
    {
        if (ProductId == Guid.Empty || _selectedFile is null)
        {
            Snackbar.Add("Please save the product first", Severity.Warning);
            return;
        }

        try
        {
            _isUploading = true;

            var upload = await ImageApi.UploadImageAsync(_selectedFile);

            await ImageApi.AddProductImageAsync(
                ProductId,
                new AddProductImageRequest(upload.StorageKey, _altText));

            Snackbar.Add("✓ Image uploaded successfully!", Severity.Success);
            
            CancelUpload();
            await OnImagesChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploading = false;
        }
    }

    private void CancelUpload()
    {
        _selectedFile = null;
        _preview = string.Empty;
        _altText = string.Empty;
    }

    private string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}