
@inject IHttpClientFactory HttpClientFactory

<MudCard Class="product-image-card" Elevation="0">

    <MudCardHeader Class="product-image-header">
        <CardHeaderContent>
            <MudText Typo="Typo.caption" Class="product-image-label">
                Product image
            </MudText>
        </CardHeaderContent>

        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.DragIndicator"
                           Class="drag-handle"
                           Color="Color.Default"
                           Size="Size.Small"
                           title="Drag to reorder" />
        </CardHeaderActions>
    </MudCardHeader>

    <div class="product-image-preview">

        @if (!string.IsNullOrWhiteSpace(ImageSrc))
        {
            <img src="@ImageSrc"
                 alt="@Image?.AltText"
                 class="product-image" />
        }
        else
        {
            <div class="product-image-placeholder">
                <MudIcon Icon="@Icons.Material.Outlined.Image"
                         Size="Size.Large" />

                <MudText Typo="Typo.body2">
                    No image available
                </MudText>
            </div>
        }

        @if (Image?.IsPrimary == true)
        {
            <div class="product-image-primary-badge">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Size="Size.Small" />
                Main image
            </div>
        }

    </div>

    <MudCardContent Class="product-image-content">

        @if (Image is not null)
        {
            <MudText Typo="Typo.caption"
                     Class="product-image-alt"
                     title="@Image.AltText">
                @(string.IsNullOrWhiteSpace(Image.AltText)
                    ? "No alternative text"
                    : Image.AltText)
            </MudText>
        }

    </MudCardContent>

    <MudCardActions Class="product-image-actions">

        <MudButton Color="Color.Primary"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   FullWidth="true"
                   Disabled="@(Image is null || Image.IsPrimary || _processing)"
                   OnClick="SetPrimary">
            Set Main
        </MudButton>

        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                       Color="Color.Error"
                       Variant="Variant.Outlined"
                       Size="Size.Small"
                       Disabled="@(Image is null || _processing)"
                       title="Delete image"
                       OnClick="DeleteImage" />

    </MudCardActions>

</MudCard>

@code {
    [Parameter]
    public Guid ProductId { get; set; }

    [Parameter]
    public ProductImageResponse? Image { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSetPrimary { get; set; }

    private bool _processing;

    private string? ImageSrc
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Image?.Url))
                return null;

            var relativeUri = Image.Url.TrimStart('/');

            var httpClient = HttpClientFactory.CreateClient("Catalog");

            var baseUri = httpClient.BaseAddress?.ToString().TrimEnd('/');

            if (string.IsNullOrWhiteSpace(baseUri))
                return null;

            return $"{baseUri}/{relativeUri}";
        }
    }

    private async Task SetPrimary()
    {
        if (Image is null || Image.IsPrimary || _processing)
            return;

        _processing = true;

        try
        {
            await OnSetPrimary.InvokeAsync(Image.Id);
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task DeleteImage()
    {
        if (Image is null || _processing)
            return;

        _processing = true;

        try
        {
            await OnDelete.InvokeAsync(Image.Id);
        }
        finally
        {
            _processing = false;
        }
    }
}
