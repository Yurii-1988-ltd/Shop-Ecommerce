@page "/products/edit/{Id:guid}"

@using Ecommerce.Admin.Components.Pages.Images

@inject NavigationManager Navigation

<PageTitle>Edit Product</PageTitle>

<PageHeader Title="Edit Product"
            Subtitle="Update product information">
    <Actions>
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/products">
            Back
        </MudButton>
    </Actions>
</PageHeader>

@if (_model is null)
{
    <MudProgressCircular Indeterminate="true"
                         Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="3">

        <MudItem xs="12" md="8">

            <MudPaper Class="pa-4">

                <MudText Typo="Typo.h6" Class="mb-4">
                    Product Information
                </MudText>

                <ProductForm Model="_model"
                             OnSubmit="UpdateProduct" />

            </MudPaper>

        </MudItem>

        <MudItem xs="12" md="4">

            <MudPaper Class="pa-4">

                <ProductImages ProductId="@Id" />

            </MudPaper>

        </MudItem>

    </MudGrid>
}

@code
{
    [Parameter]
    public Guid Id { get; set; }

    private ProductFormModel? _model;

    protected override async Task OnInitializedAsync()
    {
        var product = await CatalogApi.GetAsync(Id);

        if (product is null)
        {
            Navigation.NavigateTo("/products");
            return;
        }

        _model = new ProductFormModel
        {
            Name = product.Name,
            Description = product.Description,
            Sku = product.Sku,
            Price = product.Price,
            Currency = product.Currency
        };
    }

    private async Task UpdateProduct(ProductFormModel model)
    {
        var request = new UpdateProductRequest
        {
            Name = model.Name,
            Description = model.Description,
            Sku = model.Sku,
            Price = model.Price,
            Currency = model.Currency
        };

        await CatalogApi.UpdateAsync(Id, request);

        Navigation.NavigateTo("/products");
    }

}