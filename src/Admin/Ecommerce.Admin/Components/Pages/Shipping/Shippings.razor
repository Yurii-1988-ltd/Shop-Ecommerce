@page "/shippings"

@using Ecommerce.Admin.ApiClients.Shippings
@using Ecommerce.Admin.ApiClients.Shippings.Api
@using Ecommerce.Admin.ApiClients.Shippings.Models



<PageHeader Title="Shippings" Subtitle="Manage customer shipments" />

<MudPaper Class="pa-4">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
        <MudTextField @bind-Value="_search"
                      Placeholder="Search by tracking number or recipient..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="400"
                      OnDebounceIntervalElapsed="OnSearchChanged" />

        <MudSelect T="string"
                   Value="_selectedStatus"
                   ValueChanged="OnStatusChanged"
                   Label="Status"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true"
                   Style="min-width: 180px">

            @foreach (var status in _statuses)
            {
                <MudSelectItem Value="@status">@status</MudSelectItem>
            }
        </MudSelect>

        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadShippings">
            Refresh
        </MudButton>
    </MudStack>

    <MudTable T="ShippingResponse"
              Items="_shippings"
              Loading="_loading"
              Hover="true"
              Dense="true"
              Striped="true">

        <HeaderContent>
            <MudTh>Order</MudTh>
            <MudTh>Recipient</MudTh>
            <MudTh>City</MudTh>
            <MudTh>Shipping Method</MudTh>
            <MudTh>Tracking Number</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Order">@context.OrderId</MudTd>
            <MudTd DataLabel="Recipient">@context.RecipientName</MudTd>
            <MudTd DataLabel="City">@context.City</MudTd>
            <MudTd DataLabel="Shipping Method">@context.ShippingMethodName</MudTd>
            <MudTd DataLabel="Tracking Number">
                @(context.TrackingNumber ?? "—")
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                    @context.Status
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Created">
                @context.CreatedAtUtc.ToLocalTime().ToString("g")
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Primary"
                               Href="@($"/shippings/{context.Id}")"
                               Title="Details" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4" Color="Color.Secondary">
                No shippings found.
            </MudText>
        </NoRecordsContent>
    </MudTable>

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-4">
        <MudText Typo="Typo.body2">
            Total: @_totalCount
        </MudText>

        <MudPagination Count="@_totalPages"
                       Selected="@_page"
                       SelectedChanged="OnPageChanged"
                       ShowFirstButton="true"
                       ShowLastButton="true" />
    </MudStack>
</MudPaper>
@code
{
    [Inject]
    private IShippingApiClient ShippingApiClient { get; set; } = default!;
    private List<ShippingResponse> _shippings = [];
    private bool _loading;
    private string? _search;
    private string? _selectedStatus;

    private int _page = 1;
    private int _pageSize = 10;
    private int _totalCount;
    private int _totalPages => Math.Max(1, (int)Math.Ceiling((double)_totalCount / _pageSize));

    private readonly string[] _statuses =
    [
        "Pending",
        "Processing",
        "ReadyForShipment",
        "Shipped",
        "InTransit",
        "OutForDelivery",
        "Delivered",
        "Failed",
        "Returned",
        "Cancelled"
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadShippings();
    }

    private async Task LoadShippings()
    {
        _loading = true;

        try
        {
            var result = await ShippingApiClient.GetAllAsync(
                _page,
                _pageSize,
                _selectedStatus,
                _search);

            _shippings = result?.Items.ToList() ?? [];
            _totalCount = result?.TotalCount ?? 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
        await LoadShippings();
    }

    private async Task OnStatusChanged(string? value)
    {
        _selectedStatus = value;
        _page = 1;
        await LoadShippings();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadShippings();
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Delivered" => Color.Success,
        "Shipped" or "InTransit" or "OutForDelivery" => Color.Info,
        "Failed" or "Cancelled" => Color.Error,
        "Returned" => Color.Warning,
        "Processing" or "ReadyForShipment" => Color.Secondary,
        _ => Color.Default
    };
}