@page "/brands"

@using MudBlazor

@inject IBrandApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageHeader Title="Brands"
            Subtitle="Manage your brand catalog">

    <Actions>
        <MudButton variant="Variant.Filled"
                   color="Color.Primary"
                   start-icon="@Icons.Material.Filled.Add"
                   href="/brands/create">
            Add Brand
        </MudButton>
    </Actions>

</PageHeader>

<SearchToolbar Placeholder="Search brand..."
               OnRefresh="LoadBrands" />

<MudPaper class="entity-card" elevation="2">

    <MudTable T="BrandListItemResponse"
              class="entity-table"
              items="_brands"
              hover="true"
              dense="true"
              striped="true">

        <HeaderContent>
            <MudTh>Brand Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh align="@Align.Right">Actions</MudTh>
        </HeaderContent>

        <RowTemplate>

            <MudTd class="product-column">

                <MudStack spacing="0">
                    <MudLink class="product-name"
                             href="@($"/brands/{context.Id}")">
                        @context.Name
                    </MudLink>
                </MudStack>

            </MudTd>

            <MudTd>
                <StatusChip IsActive="@context.IsActive" />
            </MudTd>

            <MudTd align="@Align.Right">

                <EntityActions OnDetails="@(() => Details(context.Id))"
                               OnEdit="@(() => Edit(context.Id))"
                               OnDelete="@(() => Delete(context))" />

            </MudTd>

        </RowTemplate>

        <NoRecordsContent>
            <EmptyState Title="No brands"
                        Description="Create your first brand."
                        ActionText="Add brand"
                        ActionHref="/brands/create" />
        </NoRecordsContent>

    </MudTable>

</MudPaper>

@code {

    private readonly List<BrandListItemResponse> _brands = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadBrands();
    }

    private async Task LoadBrands()
    {
        var result = await Api.GetAllAsync(1, 20);

        _brands.Clear();

        if (result?.Items is not null)
        {
            _brands.AddRange(result.Items);
        }
    }

    private void Details(Guid id)
    {
        Navigation.NavigateTo($"/brands/{id}");
    }

    private void Edit(Guid id)
    {
        Navigation.NavigateTo($"/brands/edit/{id}");
    }

    private async Task Delete(BrandListItemResponse brand)
    {
        var parameters = new DialogParameters
        {
            {
                nameof(ConfirmationDialog.Title),
                "Delete brand"
            },
            {
                nameof(ConfirmationDialog.Message),
                $"Are you sure you want to delete '{brand.Name}'?\n\nThis action cannot be undone."
            }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>(
            "Delete brand",
            parameters);

        var dialogResult = await dialog.Result;

        if (dialogResult is null || dialogResult.Canceled)
        {
            return;
        }

        await Api.DeleteAsync(brand.Id);

        await LoadBrands();
    }
}
