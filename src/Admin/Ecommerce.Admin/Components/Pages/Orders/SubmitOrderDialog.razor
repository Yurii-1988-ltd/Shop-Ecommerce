<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Submit Order
        </MudText>
    </TitleContent>

    <DialogContent>

        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
            Are you sure you want to submit this order?
        </MudAlert>

        <MudText Typo="Typo.body1">
            <b>Order:</b> @OrderNumber
        </MudText>

        <MudText Typo="Typo.body2" Class="mt-3">
            After submission the order status will change from
            <b>Draft</b> to <b>Pending</b>.
        </MudText>

    </DialogContent>

    <DialogActions>

        <MudButton Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit">
            Submit
        </MudButton>

    </DialogActions>

</MudDialog>

@code
{
    [Parameter]
    public string OrderNumber { get; set; } 

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Submit()
        => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel()
        => MudDialog.Cancel();
    public static string GetOrderNumber(Guid id)
    {
        var value = id.ToString("N").ToUpper();
        return $"ORD-{value[..4]}-{value[4..8]}";
    }
}