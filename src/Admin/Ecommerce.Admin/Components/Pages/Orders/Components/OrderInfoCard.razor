<MudPaper Class="pa-4 mb-3">
    <MudPaper Class="pa-5 mb-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" Class="fw-bold mb-3">
                    @GetOrderNumber(Order.Id)
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Created @Order.CreatedAtUtc.ToLocalTime()
                </MudText>
            </MudStack>

            <MudChip T="OrderStatus" Size="Size.Large" Variant="Variant.Filled" Color="@GetStatusColor(Order.Status)">
                @Order.Status
            </MudChip>
        </MudStack>
    </MudPaper>

    <MudGrid>
        <MudItem xs="6">
            <MudText Typo="Typo.caption">Status</MudText>
            <MudChip T="OrderStatus" Variant="Variant.Outlined" Color="@GetStatusColor(Order.Status)">
                @Order.Status
            </MudChip>
        </MudItem>

        <MudItem xs="6">
            <MudText Typo="Typo.caption">Created</MudText>
            <MudText Typo="Typo.body1">@Order.CreatedAtUtc.ToLocalTime().ToString("g")</MudText>
        </MudItem>

        <MudItem xs="6">
            <MudText Typo="Typo.caption">Currency</MudText>
            <MudText Typo="Typo.body1">@Order.Currency</MudText>
        </MudItem>

        <MudItem xs="6">
            <MudText Typo="Typo.caption">Items</MudText>
            <MudText Typo="Typo.body1">@Order.TotalQuantity</MudText>
        </MudItem>

        <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.caption">Total Amount</MudText>
            <MudText Typo="Typo.h5" Color="Color.Success">
                @Order.TotalAmount @Order.Currency
            </MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter, EditorRequired] public OrderResponse Order { get; set; } = default!;

    private Color GetStatusColor(OrderStatus status) => status switch
    {
        OrderStatus.Draft => Color.Default,
        OrderStatus.Pending => Color.Info,
        OrderStatus.Paid => Color.Success,
        OrderStatus.Processing => Color.Warning,
        OrderStatus.Shipped => Color.Secondary,
        OrderStatus.Delivered => Color.Success,
        OrderStatus.Cancelled => Color.Error,
        OrderStatus.Refunded => Color.Dark,
        _ => Color.Default
    };

    private static string GetOrderNumber(Guid id)
    {
        var value = id.ToString("N").ToUpper();
        return $"ORD-{value[..4]}-{value[4..8]}";
    }
}