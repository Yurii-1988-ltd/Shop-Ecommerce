
@page "/orders/{Slug}"

@if (_order is null)
{
    <div class="d-flex justify-content-center my-6">
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary"
                             Size="Size.Large" />
    </div>
}
else
{
    <MudGrid Spacing="3">

        @* LEFT COLUMN *@
        <MudItem xs="12" md="8" Class="d-flex flex-column">
            <OrderInfoCard Order="_order" />

            <OrderItemsTable Items="_order.Items"
                             ReadOnly="IsReadOnly"
                             OnAddItem="OpenAddItemDialogAsync"
                             OnRemoveItem="RemoveOrderItemAsync"
                             OnQuantityChanged="ChangeItemQuantityAsync" />
        </MudItem>

        @* RIGHT COLUMN *@
        <MudItem xs="12" md="4">
            <MudStack Spacing="3">

                @* CUSTOMER *@
                @if (_order.CustomerId.HasValue)
                {
                    <OrderCustomerCard
                        CustomerName="@_order.CustomerName"
                        CustomerId="@_order.CustomerId.Value" />
                }
                else
                {
                    <MudCard>
                        <MudCardContent>
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h6">
                                    Guest Customer
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    @_order.CustomerName
                                </MudText>

                               @*  @if (!string.IsNullOrWhiteSpace(_order.CustomerEmail))
                                {
                                    <MudText Typo="Typo.body2"
                                             Color="Color.Secondary">
                                        @_order.Сгі
                                    </MudText>
                                } *@
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                }

                @* SHIPPING ADDRESS *@
                <OrderShippingAddressCard
                    Address="_order.ShippingAddress" />

                @* ORDER SUMMARY *@
                <OrderSummaryCard
                    TotalQuantity="_order.TotalQuantity"
                    Currency="_order.Currency"
                    TotalAmount="_order.TotalAmount" />

                @* ACTIONS *@
                <OrderActionsCard
                    Order="_order"
                    OnSubmit="OpenSubmitDialogAsync"
                    OnChangeStatus="OpenChangeStatusDialogAsync"
                    OnForceChangeStatus="OpenForceChangeStatusDialogAsync" />

            </MudStack>
        </MudItem>

    </MudGrid>
}
