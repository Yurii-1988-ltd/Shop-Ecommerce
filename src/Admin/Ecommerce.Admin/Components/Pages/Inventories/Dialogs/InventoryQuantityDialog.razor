<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @if (!string.IsNullOrWhiteSpace(Icon))
            {
                <MudIcon Icon="@Icon"
                         Class="me-2" />
            }

            @Title
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3" Class="pt-2">

            <MudText Typo="Typo.body2">
                SKU: <b>@SKU</b>
            </MudText>

            <MudText Typo="Typo.body2">
                @QuantityLabel: <b>@CurrentQuantity</b>
            </MudText>

            <MudNumericField T="int"
                             Label="Quantity"
                             @bind-Value="_quantity"
                             Min="1"
                             Required="true"
                             Variant="Variant.Outlined" />

        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@(_quantity <= 0)">
            @ActionText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Inventory";

    [Parameter]
    public string ActionText { get; set; } = "Save";
    [Parameter]
    public int OnHandQuantity{ get; set; }
    [Parameter]
    public int AvailableQuantity { get; set; }

        

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string SKU { get; set; } = string.Empty;

    [Parameter]
    public string QuantityLabel { get; set; } = "Available";

    [Parameter]
    public int CurrentQuantity { get; set; }

    private int _quantity = 1;

    private void Save()
    {
        MudDialog.Close(DialogResult.Ok(_quantity));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}