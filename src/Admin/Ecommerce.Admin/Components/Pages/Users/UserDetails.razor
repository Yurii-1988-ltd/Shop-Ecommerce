@page "/users/{Id:guid}"

<PageTitle>User Details</PageTitle>

@if (_isLoading)
{
    <div class="user-details-loading">
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary"
                             Size="Size.Large" />
        <MudText Typo="Typo.body2" Class="user-details-loading-text">
            Loading user information...
        </MudText>
    </div>
}
else if (_user is not null)
{
    <PageHeader Title="@($"{_user.FirstName} {_user.LastName}")"
                Subtitle="@_user.Email">
        <Actions>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Edit"
                       Href="@($"/users/{_user.Id}/edit")"
                       Class="user-details-edit-button">
                Edit
            </MudButton>

            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.ArrowBack"
                       OnClick="GoBack"
                       Class="user-details-back-button">
                Back
            </MudButton>
        </Actions>
    </PageHeader>

    <MudGrid Spacing="3" Class="user-details-grid">

        <MudItem xs="12" md="8">
            <UserInformationCard User="_user" />
        </MudItem>

        <MudItem xs="12" md="4">
            <UserRolesCard UserId="Id" />
        </MudItem>

    </MudGrid>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UserResponse? _user;
    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        try
        {
            _user = await UserApi.GetAsync(Id);

            if (_user is null)
            {
                Navigation.NavigateTo("/users");
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/users");
    }
}
