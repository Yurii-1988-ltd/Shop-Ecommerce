@page "/"
@using Ecommerce.Domain.Enums
@using Ecommerce.Storefront.ApiClients.Catalogs.Models

@inject ICatalogApiClient CatalogApiClient

<PageTitle>Ecommerce — Home</PageTitle>

<!-- HERO SECTION -->
<section class="hero">
    <div class="hero__content">
        <span class="hero__eyebrow">NEW COLLECTION 2026</span>
        <h1 class="hero__title">
            Everything you need.
            <span>All in one place.</span>
        </h1>
        <p class="hero__description">
            Discover products selected for quality, design, and everyday life.
        </p>

        <div class="hero__actions">
            <a href="/products" class="hero__button hero__button--primary">
                Shop now
            </a>
            <a href="/products?sort=newest" class="hero__button hero__button--secondary">
                Explore collection
            </a>
        </div>
    </div>

    <div class="hero__visual" @onmousemove="HandleMouseMove">
        <div class="hero__circle"></div>
        <div class="hero__product-card" style="transform: translate(@(_mouseX)px, @(_mouseY)px)">
            <span class="hero__badge">Featured</span>
            <div class="hero__placeholder-logo">E</div>
        </div>
    </div>
</section>

<!-- CATEGORIES SECTION -->
<section class="categories">
    <div class="section-header">
        <div>
            <span class="section-header__eyebrow">EXPLORE</span>
            <h2>Shop by category</h2>
        </div>
        <a href="/products" class="section-header__link">View all →</a>
    </div>

    <div class="categories-grid">
        @if (_categories.Count == 0 && _loading)
        {
            @for (int i = 0; i < 4; i++)
            {
                <div class="category-skeleton" style="height: 100px; background: #eee; border-radius: 8px;"></div>
            }
        }
        else if (_categories.Count == 0)
        {
            <p>No categories found.</p>
        }
        else
        {
            @foreach (var category in _categories.Take(4))
            {
                <a href="/products?categoryId=@category.Id" class="category-card">
                    <span class="category-card__icon">@GetCategoryIcon(category.Name)</span>
                    <span class="category-card__title">@category.Name</span>
                </a>
            }
        }
    </div>
</section>

<!-- FEATURED PRODUCTS SECTION -->
<section class="featured-products">
    <div class="section-header">
        <div>
            <span class="section-header__eyebrow">HAND PICKED</span>
            <h2>Featured products</h2>
        </div>
        <a href="/products" class="section-header__link">View all →</a>
    </div>

    @if (_loading)
    {
        <div class="products-grid">
            @for (int i = 0; i < 4; i++)
            {
                <div class="product-skeleton"></div>
            }
        </div>
    }
    else if (_products.Count == 0)
    {
        <div class="products-empty">
            <p>No products available at the moment.</p>
        </div>
    }
    else
    {
        <div class="products-grid">
            @foreach (var product in _products)
            {
                <ProductCard Product="product" />
            }
        </div>
    }
</section>

<!-- PROMO BANNER -->
<section class="promo">
    <div class="promo__content">
        <span class="promo__eyebrow">LIMITED OFFER</span>
        <h2>Better products. Better prices.</h2>
        <p>Discover our latest deals and special offers with up to 30% discount.</p>
        <a href="/products?sale=true" class="promo__button">Explore deals</a>
    </div>
</section>

<!-- BENEFITS SECTION -->
<section class="benefits">
    <div class="benefit">
        <div class="benefit__icon">🚚</div>
        <div class="benefit__info">
            <h3>Fast delivery</h3>
            <p>Get your order delivered quickly.</p>
        </div>
    </div>
    <div class="benefit">
        <div class="benefit__icon">🔒</div>
        <div class="benefit__info">
            <h3>Secure payment</h3>
            <p>Your payment information is protected.</p>
        </div>
    </div>
    <div class="benefit">
        <div class="benefit__icon">↩</div>
        <div class="benefit__info">
            <h3>Easy returns</h3>
            <p>Simple and convenient 30-day returns.</p>
        </div>
    </div>
</section>

@code {
    private readonly List<ProductListItemResponse> _products = [];
    private List<CategoryListItemResponse> _categories = [];
    private bool _loading;

    private double _mouseX = 0;
    private double _mouseY = 0;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        try
        {
            // Параллельно загружаем товары и список категорий для главной страницы
            var productsTask = CatalogApiClient.GetProductsAsync(
                page: 1,
                pageSize: 4,
                sortOption: ProductSortOptions.Relevance);

            var categoriesTask = CatalogApiClient.GetCategoriesAsync();

            await Task.WhenAll(productsTask, categoriesTask);

            var productsResult = productsTask.Result;
            if (productsResult is not null)
            {
                _products.AddRange(productsResult.Items);
            }

            var categoriesResult = categoriesTask.Result;
            if (categoriesResult is not null)
            {
                _categories = categoriesResult;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        _mouseX = (e.OffsetX - 150) * 0.03;
        _mouseY = (e.OffsetY - 150) * 0.03;
    }
    private string GetCategoryIcon(string categoryName)
    {
        var name = categoryName.ToLowerInvariant();

        return name switch
        {
            var n when n.Contains("mobile") || n.Contains("phone") || n.Contains("смартфон") => "📱",
            var n when n.Contains("notebook") || n.Contains("laptop") || n.Contains("computer") || n.Contains("ноутбук") => "💻",
            var n when n.Contains("audio") || n.Contains("headphone") || n.Contains("наушник") => "🎧",
            var n when n.Contains("game") || n.Contains("gamer") || n.Contains("игра") || n.Contains("геймер") => "🎮",
            var n when n.Contains("watch") || n.Contains("accessory") || n.Contains("аксессуар") => "⌚",
            var n when n.Contains("tv") || n.Contains("video") => "📺",
            _ => "📦"
        };
    }
}