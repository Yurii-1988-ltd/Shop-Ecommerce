@page "/products/{Id:guid}"
@rendermode InteractiveServer
@inject CartState CartState
@inject IConfiguration Configuration

<PageTitle>@(_product?.Name ?? "Product Details")</PageTitle>

@if (_loading)
{
    <div class="product-details__loading">
        <div class="spinner"></div>
        <p>Loading product details...</p>
    </div>
}
else if (_product is null)
{
    <div class="product-details__not-found">
        <h1>Product Not Found</h1>
        <p>The product you are looking for does not exist or has been removed.</p>
        <a class="product-details__back" href="/products">
            ← Back to products
        </a>
    </div>
}
else
{
    <section class="product-details">
        <a class="product-details__back" href="/products">
            ← Back to products
        </a>

        <div class="product-details__grid">
            @* 1. Галерея изображений *@
            <div class="product-details__media">
                <div class="product-details__main-image">
                    @if (!string.IsNullOrEmpty(_selectedImageUrl))
                    {
                        <img src="@GetFullImageUrl(_selectedImageUrl)" alt="@_product.Name" />
                    }
                    else
                    {
                        <div class="product-details__image-placeholder">
                            <span>No Image Available</span>
                        </div>
                    }

                    @if (_product.SalePrice.HasValue)
                    {
                        <span class="product-details__badge product-details__badge--sale">Sale</span>
                    }
                </div>

                @if (_product.Images is not null && _product.Images.Count > 1)
                {
                    <div class="product-details__thumbnails">
                        @foreach (var img in _product.Images.OrderBy(i => i.DisplayOrder))
                        {
                            <button type="button"
                                    class="thumbnail-btn @(_selectedImageUrl == img.Url ? "active" : "")"
                                    @onclick="() => SelectImage(img.Url)">
                                <img src="@GetFullImageUrl(string.IsNullOrEmpty(img.ThumbnailUrl) ? img.Url : img.ThumbnailUrl)"
                                     alt="@(img.AltText ?? _product.Name)" />
                            </button>
                        }
                    </div>
                }
            </div>

            @* 2. Информационный блок *@
            <div class="product-details__info">
                <h1 class="product-details__title">@_product.Name</h1>

                <div class="product-details__meta">
                    <span class="product-details__sku">SKU: <strong>@_product.Sku</strong></span>
                </div>

                <div class="product-details__price">
                    @if (_product.SalePrice.HasValue)
                    {
                        <span class="product-details__sale-price">
                            @_product.SalePrice.Value @_product.Currency
                        </span>
                        <del class="product-details__old-price">
                            @_product.Price @_product.Currency
                        </del>
                    }
                    else
                    {
                        <span class="product-details__current-price">
                            @_product.Price @_product.Currency
                        </span>
                    }
                </div>

                <p class="product-details__description">
                    @_product.Description
                </p>

                <div class="product-details__availability">
                    @if (_product.IsActive && _availableQuantity > 0)
                    {
                        <span class="product-details__availability--in-stock">
                            In stock (@_availableQuantity pcs)
                        </span>
                    }
                    else
                    {
                        <span class="product-details__availability--out-of-stock">
                            Out of stock
                        </span>
                    }
                </div>

                @* 3. Действия (Количество и Кнопка) *@
                <div class="product-actions">
                    @if (_product.IsActive && _availableQuantity > 0)
                    {
                        <div class="quantity-selector">
                            <button type="button"
                                    class="quantity-btn"
                                    @onclick="DecreaseQuantity"
                                    disabled="@(_quantity <= 1 || _isAdding)">
                                −
                            </button>
                            <span class="quantity-value">@_quantity</span>
                            <button type="button"
                                    class="quantity-btn"
                                    @onclick="IncreaseQuantity"
                                    disabled="@(_quantity >= _availableQuantity || _isAdding)">
                                +
                            </button>
                        </div>
                    }

                    <button type="button"
                            class="add-to-cart-btn @(_isAdding ? "loading" : "")"
                            disabled="@(!_product.IsActive || _availableQuantity <= 0 || _isAdding)"
                            @onclick="AddToCart">
                        @if (_isAdding)
                        {
                            <span class="btn-spinner"></span>
                            <span>Adding...</span>
                        }
                        else
                        {
                            <svg class="cart-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <span>Add to cart</span>
                        }
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_toastMessage))
                {
                    <div class="toast-notification">
                        <svg class="toast-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@_toastMessage</span>
                    </div>
                }

                <div class="product-details__features">
                    <div class="feature-item">
                        <strong>Fast Delivery:</strong> Ships within 1-2 business days.
                    </div>
                    <div class="feature-item">
                        <strong>Official Guarantee:</strong> Quality assurance from the manufacturer.
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ProductDetailsResponse? _product;
    private string? _selectedImageUrl;
    private int _availableQuantity;
    private int _quantity = 1;
    private bool _loading;
    private bool _isAdding;
    private string? _toastMessage;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        try
        {
            _product = await CatalogApiClient.GetAsync(Id);

            if (_product is not null)
            {
                // Приоритет изображения: IsPrimary == true, либо первое из коллекции
                _selectedImageUrl = _product.Images?.FirstOrDefault(i => i.IsPrimary)?.Url
                                    ?? _product.Images?.FirstOrDefault()?.Url;

                var inventory = await InventoryApiClient.GetAvailabilityAsync(_product.Id);
                _availableQuantity = inventory?.AvailableQuantity ?? _product.StockQuantity;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectImage(string url)
    {
        _selectedImageUrl = url;
    }

    private void IncreaseQuantity()
    {
        if (_quantity < _availableQuantity)
        {
            _quantity++;
        }
    }

    private void DecreaseQuantity()
    {
        if (_quantity > 1)
        {
            _quantity--;
        }
    }

    private async Task AddToCart()
    {
        if (_product is null || !_product.IsActive || _availableQuantity <= 0 || _isAdding)
        {
            return;
        }

        _isAdding = true;

        try
        {
            var request = new AddCartItemRequest(
                _product.Id,
                _product.Name,
                _product.Sku,
                _product.SalePrice ?? _product.Price,
                _product.Currency,
                _quantity);

            await CartApiClient.AddItemAsync(request);
            var cart = await CartApiClient.GetAsync();
            CartState.SetTotalItems(cart?.TotalItems ?? 0);

            ShowToast($"Added {_quantity} item(s) to cart");
        }
        finally
        {
            _isAdding = false;
        }
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            _toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    private string GetFullImageUrl(string? relativeOrAbsoluteUrl)
    {
        if (string.IsNullOrWhiteSpace(relativeOrAbsoluteUrl))
        {
            return "/images/no-image.png";
        }

        if (relativeOrAbsoluteUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            relativeOrAbsoluteUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return relativeOrAbsoluteUrl;
        }

        var apiBaseUrl = Configuration["ApiBaseUrl"]?.TrimEnd('/') ?? "";
        return $"{apiBaseUrl}/{relativeOrAbsoluteUrl.TrimStart('/')}";
    }
}