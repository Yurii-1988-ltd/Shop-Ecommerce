@page "/products"
@using Ecommerce.Application.Pagination
@inject ICatalogApiClient CatalogApiClient
@inject NavigationManager Navigation

<div class="catalog-page">
 
    <aside class="catalog-sidebar">
        <CategoryFilter SelectedCategoryId="_selectedCategoryId"
                        OnCategoryChanged="HandleCategoryChanged" />
    </aside>

  
    <main class="catalog-content">
        <h2>Products</h2>

        @if (_products == null)
        {
            <p>Loading products...</p>
        }
        else
        {
            <div class="products-grid">
                @foreach (var product in _products.Items)
                {
                    <ProductCard Product="product" />
                }
            </div>
        }
    </main>
</div>

@code {
    [SupplyParameterFromQuery(Name = "categoryId")]
    private Guid? _selectedCategoryId { get; set; }

    private PagedResult<ProductListItemResponse>? _products;

    protected override async Task OnParametersSetAsync()
    {
    
        _products = await CatalogApiClient.GetProductsAsync(categoryId: _selectedCategoryId);
    }

    private async Task HandleCategoryChanged(Guid? categoryId)
    {
        _selectedCategoryId = categoryId;

    
        var uri = Navigation.GetUriWithQueryParameter("categoryId", categoryId);
        Navigation.NavigateTo(uri);


        _products = await CatalogApiClient.GetProductsAsync(categoryId: categoryId);
    }
}