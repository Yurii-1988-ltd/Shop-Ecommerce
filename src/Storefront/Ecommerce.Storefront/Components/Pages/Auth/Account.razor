
@page "/auth/account"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject IIdentityApiClient IdentityApiClient

<PageTitle>My Account</PageTitle>

<AuthorizeView>
    <Authorized Context="authContext">

        <section class="account-page">

            <div class="account-header">
                <div>
                    <span class="account-eyebrow">
                        ACCOUNT
                    </span>

                    <h1>My Account</h1>

                    <p>
                        Manage your account and orders.
                    </p>
                </div>
            </div>

            <div class="account-grid">

                <!-- Profile -->
                <section class="account-card account-card--profile">

                    <div class="account-card__header">

                        <div class="account-avatar">
                            @GetInitials(authContext.User)
                        </div>

                        <div>
                            <h2>Profile</h2>

                            <span>
                                @authContext.User.FindFirstValue(
                                    ClaimTypes.Email)
                            </span>
                        </div>

                    </div>

                    <div class="account-profile">

                        <div class="account-form-row">

                            <div class="account-field">
                                <label for="first-name">
                                    First name
                                </label>

                                <input id="first-name"
                                       type="text"
                                       @bind="_firstName"
                                       placeholder="First name" />
                            </div>

                            <div class="account-field">
                                <label for="last-name">
                                    Last name
                                </label>

                                <input id="last-name"
                                       type="text"
                                       @bind="_lastName"
                                       placeholder="Last name" />
                            </div>

                        </div>

                        <div class="account-form-row">

                            <div class="account-field">
                                <label for="email">
                                    Email
                                </label>

                                <input id="email"
                                       type="email"
                                       @bind="_email"
                                       placeholder="Email" />
                            </div>

                            <div class="account-field">
                                <label for="phone">
                                    Phone
                                </label>

                                <input id="phone"
                                       type="tel"
                                       @bind="_phone"
                                       placeholder="+380..." />
                            </div>

                        </div>

                        <div class="account-profile__actions">

                            <button type="button"
                                    class="account-button"
                                    disabled="@_isSaving"
                                    @onclick="SaveProfile">
                                @(_isSaving ? "Saving..." : "Save changes")
                            </button>

                            @if (_saveSuccess)
                            {
                                <div class="account-save-success">
                                    Profile updated successfully.
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_saveError))
                            {
                                <div class="account-save-error">
                                    @_saveError
                                </div>
                            }

                        </div>

                    </div>

                </section>

                <!-- My Orders -->
                <section class="account-card account-card--orders">

                    <div class="account-section-header">

                        <div>
                            <span class="account-card__eyebrow">
                                ORDERS
                            </span>

                            <h2>My Orders</h2>

                            <p>
                                View your order history and track deliveries.
                            </p>
                        </div>

                        <span class="account-section-icon">
                            📦
                        </span>

                    </div>

                    <div class="account-orders-empty">

                        <div class="account-orders-empty__icon">
                            📦
                        </div>

                        <h3>No orders yet</h3>

                        <p>
                            Your orders will appear here after you
                            place your first order.
                        </p>

                        <a href="/products"
                           class="account-button">
                            Start shopping
                        </a>

                    </div>

                </section>

                <!-- Shopping Cart -->
                <a href="/cart"
                   class="account-card account-link account-link--cart">

                    <div class="account-link__icon">
                        🛒
                    </div>

                    <div>
                        <h2>Shopping Cart</h2>

                        <p>
                            Review the products in your cart.
                        </p>
                    </div>

                    <span class="account-link__arrow">
                        →
                    </span>

                </a>

            </div>

        </section>

    </Authorized>

    <NotAuthorized>

        <section class="account-unauthorized">

            <div class="account-unauthorized__icon">
                🔐
            </div>

            <h1>Sign in required</h1>

            <p>
                Sign in to access your account.
            </p>

            <a href="/auth/login"
               class="account-button">
                Sign in
            </a>

        </section>

    </NotAuthorized>

</AuthorizeView>
