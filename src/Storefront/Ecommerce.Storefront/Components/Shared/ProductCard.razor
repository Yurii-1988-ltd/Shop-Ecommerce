@using Ecommerce.Storefront.ApiClients.Catalogs.Models

@using Ecommerce.Storefront.Services


@inject IConfiguration Configuration
@inject CurrencyState CurrencyState

@implements IDisposable

<div class="product-card">
    <a href="/products/@Product.Id" class="product-card__image">
        @if (!string.IsNullOrWhiteSpace(Product.ImageUrl))
        {
            <img src="@GetFullImageUrl(Product.ImageUrl)"
                 alt="@Product.Name"
                 loading="lazy" />
        }
        else
        {
            <div class="product-card__no-image">
                <span>No Image</span>
            </div>
        }
    </a>

    <div class="product-card__content">
        <a href="/products/@Product.Id"
           class="product-card__name"
           title="@Product.Name">
            @Product.Name
        </a>

        <div class="product-card__price">
            @if (_ratesLoaded)
            {
                <span>
                    @CurrencyState.FormatPrice(Product.Price, Product.Currency)
                </span>
            }
            else
            {
                <span>@Product.Price @Product.Currency</span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ProductListItemResponse Product { get; set; } = default!;

    private bool _ratesLoaded;

    protected override async Task OnInitializedAsync()
    {
        CurrencyState.Changed += OnCurrencyChanged;

        try
        {
            await CurrencyState.InitializeAsync();
            _ratesLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Currency rates loading failed: {ex.Message}");
        }
    }

    private void OnCurrencyChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetFullImageUrl(string url)
    {
        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }

        var apiBaseUrl = Configuration["ApiSettings:BaseUrl"]
                         ?? "https://localhost:7125";

        return $"{apiBaseUrl.TrimEnd('/')}/{url.TrimStart('/')}";
    }

    public void Dispose()
    {
        CurrencyState.Changed -= OnCurrencyChanged;
    }
}